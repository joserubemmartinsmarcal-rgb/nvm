# Copie para `.env.local` e preencha. Nada aqui deve ir para o Git.

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave `service_role`. É ela que lê os chamados, porque o app não tem mais
# login de usuário — quem controla o acesso é a senha do site, na frente.
# Sem NEXT_PUBLIC_: nunca pode ir para o navegador.
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp — só para responder o cliente pelo sistema.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_API_VERSION=v21.0
