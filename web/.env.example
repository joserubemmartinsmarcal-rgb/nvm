# Copie para `.env.local` e preencha. Nada aqui deve ir para o Git.

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# WhatsApp — só para responder o cliente pelo sistema.
# Sem NEXT_PUBLIC_: são segredos de servidor e não podem ir para o navegador.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_API_VERSION=v21.0
